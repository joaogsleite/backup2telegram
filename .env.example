# Get these from https://my.telegram.org -> API development tools
TG_API_ID=1234567
TG_API_HASH=0123456789abcdef0123456789abcdef
# User session (printed on first interactive run) OR bot token - one is required
TG_SESSION=
# TG_BOT_TOKEN=
# Optional default target so `TG_TARGET=@mygroup ./src/index.ts upload ./myfile.zip` works
TG_TARGET=
